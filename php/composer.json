            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "earnings",
        "earnings api",
        "earnings report",
        "company financials",
        "income statement",
        "balance sheet"
    ],
    "homepage": "https://apiverve.com/marketplace/earnings?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/earnings",
        "source": "https://github.com/apiverve/earnings-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Earnings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Earnings\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
